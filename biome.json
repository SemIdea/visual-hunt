{
    "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",

    "files": {
        "ignoreUnknown": false,
        "includes": [
            "./src/**/*.{ts,tsx,js,jsx,json}",
            "./app/**/*.{ts,tsx,js,jsx,json}",
            "./*.{js,cjs,mjs,ts,tsx,jsx}"
        ]
    },

    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },

    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },

    "css": {
        "parser": {
            "cssModules": true
        },
        "formatter": {
            "enabled": false
        },
        "linter": {
            "enabled": false
        }
    },

    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,

            "correctness": {
                "noUnusedVariables": "error",
                "noUnusedImports": "error"
            },

            "suspicious": {
                "noVar": "error",
                "noArrayIndexKey": "warn"
            },

            "security": {
                "noDangerouslySetInnerHtml": "error"
            },

            "style": {
                "useConst": "warn",
                "noNonNullAssertion": "warn",
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "@trigger.dev/sdk/v3": "Use @trigger.dev/sdk (v4). O sufixo /v3 não é necessário e pode causar confusão.",
                            "zod/v3": "Use zod (v4) ou zod/v4. v3 não é permitido"
                        }
                    }
                }
            },

            "a11y": {
                "noRedundantAlt": "warn",
                "noStaticElementInteractions": "warn",
                "useKeyWithClickEvents": "warn",
                "useKeyWithMouseEvents": "warn",
                "useAltText": "warn",
                "useSemanticElements": "warn",
                "useValidAnchor": "warn"
            }
        }
    },

    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "jsxQuoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always"
        },
        "globals": ["React", "JSX"]
    },

    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },

    "assist": {
        "enabled": true,
        "actions": {
            "recommended": true,
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
