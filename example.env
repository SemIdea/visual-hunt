# Example environment file for local development.
# Copy this to `.env` or `.env.local` and fill in real values.

NEXT_PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0

AUTH_SESSION_ACCESS_SECRET=change-me-access
AUTH_SESSION_REFRESH_SECRET=change-me-refresh
AUTH_TOKEN_BYTE_LENGTH=32
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_SESSION_CACHE_TTL=5m
AUTH_SESSION_CACHE_KEY_PREFIX=session:
AUTH_USER_BCRYPT_COST=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=15s

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_BASIC_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_BASIC_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_EXPERT_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_EXPERT_YEARLY_PRICE_ID=

TRIGGER_SECRET_KEY=
SCRAPING_DOG_API_KEY=
SERP_API_KEY=

CLOUDINARY_URL=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
