# This is an example .env file.
# Copy this to .env.local for local development and fill in your secrets.

# ==================================
#  App & Authentication
# ==================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ==================================
#  OAuth Providers
# ==================================
# GitHub
GITHUB_ID=
GITHUB_SECRET=

# Google
GOOGLE_ID=
GOOGLE_SECRET=

# ==================================
#  Database & Caching
# ==================================
DATABASE_URL=
REDIS_URL=

# ==================================
#  Payments (Stripe)
# ==================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==================================
#  External APIs & Services
# ==================================
# Cloudinary (Media Management)
CLOUDINARY_URL=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# ScrapingDog (Web Scraping)
SCRAPING_DOG_API_KEY=

# Trigger.dev (Background Jobs)
TRIGGER_SECRET_KEY=